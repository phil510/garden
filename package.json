{
  "name": "garden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev:sandbox:server": "pnpm --filter @garden/server dev:sandbox",
    "dev:sandbox:web": "pnpm --filter @garden/web dev:sandbox",
    "screenshot": "tsx scripts/screenshot.ts",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "vitest run",
    "test:integration": "pnpm --filter @garden/server test:integration",
    "build": "pnpm -r build",
    "cli:install": "pnpm build && tsx scripts/cli-install.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  }
}
